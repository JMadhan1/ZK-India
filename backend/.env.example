# ZKGate India backend configuration. Copy to .env and adjust.
# Every value has a working default; an empty file runs fine for local dev.

ENVIRONMENT=development

# Leave empty to use the in-memory nullifier registry (no Redis required).
# In production: redis://redis:6379
REDIS_URL=

# Leave empty to use the in-memory audit chain (no Postgres required).
# In production: postgresql+asyncpg://zkgate:zkgate_dev_password@postgres:5432/zkgate
DATABASE_URL=

# Where the circuit verification keys and signal_layout.json live.
CIRCUIT_KEYS_DIR=../circuits/keys

# Require verifiers to present a registered X-API-Key. Off for the demo.
REQUIRE_API_KEY=false
